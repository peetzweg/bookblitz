{
  "name": "bookblitz",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first speed reader for your own EPUBs: one word at a time, offline, nothing uploaded.",
  "keywords": [
    "speed-reading",
    "rsvp",
    "epub",
    "epub-reader",
    "local-first",
    "offline-first",
    "pwa",
    "react",
    "vite"
  ],
  "homepage": "https://peetzweg.github.io/bookblitz/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peetzweg/bookblitz.git"
  },
  "license": "MIT",
  "author": "peetzweg <phil.czek@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
